{
  "name": "afford-today",
  "version": "0.3.0",
  "private": true,
  "description": "afford.today — a calm decision ritual for purchases and personal time",
  "workspaces": [
    "shared",
    "api",
    "app",
    "bot"
  ],
  "scripts": {
    "build:shared": "npm -w shared run build",
    "build:app": "npm -w app run build",
    "build:api": "npm -w api run build",
    "build:bot": "npm -w bot run build",
    "build": "npm run build:shared && npm run build:app && npm run build:api && npm run build:bot",
    "dev:api": "npm -w api run dev",
    "dev:app": "npm -w app run dev",
    "dev:bot": "npm -w bot run dev",
    "start": "node api/dist/server.js"
  },
  "engines": {
    "node": ">=20"
  }
}
